# Zkopíruj na .env (nebo nastav v prostředí / launchd / crontab) a doplň údaje.

# --- eBay oficiální API (provider: ebay_api v config.yaml) ---
# Získání klíče: viz EBAY_API_SETUP.md
EBAY_APP_ID=Tvuj-AppID-ClientID
EBAY_CERT_ID=Tvuj-CertID-ClientSecret

# --- E-mailové alerty (potřebné jen když alert.method = email) ---
# Pro Gmail použij App Password (ne běžné heslo): https://myaccount.google.com/apppasswords
SCOUT_SMTP_USER=your-email@example.com
SCOUT_SMTP_PASS=xxxx-xxxx-xxxx-xxxx
